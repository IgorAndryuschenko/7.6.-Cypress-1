  "main": "index.js",
  "scripts": {
    "cy:all": "npm run cy:laptop:headless && npm run cy:mobile:headless",
    "cy:laptop:headless": "cypress run --config-file cypress.config.js --browser edge",
    "cy:laptop:headed": "cypress run --config-file cypress.config.js --browser edge --headed",
    "cy:mobile:headless": "cypress run --config-file cypress.mobile.config.js --browser chrome",
    "cy:mobile:headed": "cypress run --config-file cypress.mobile.config.js --browser chrome --headed"
  },
  "dependencies": {
    "cypress": "^15.15.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0"
  }
